<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Bloodtype_TransfusionReaction</defName>
    <label>transfusion reaction</label>
    <description>An immune reaction to donor blood. This causes pain, weakness, and reduced consciousness. Severe reactions can be life-threatening without urgent care.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.10</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <defaultLabelColor>(1.0, 0.45, 0.3)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.35</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.20</minSeverity>
        <label>moderate</label>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.08</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.45</minSeverity>
        <label>severe</label>
        <painOffset>0.20</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.30</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.25</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Bloodtype_TransfusionCrisis</defName>
    <label>catastrophic transfusion crisis</label>
    <description>A severe hemolytic cascade from incompatible transfusion. Without immediate advanced intervention, this rapidly becomes fatal.</description>
    <hediffClass>BloodtypeHardcore.Hediff_TransfusionCrisisPhased</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.001</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <maxSeverity>1.0</maxSeverity>
    <defaultLabelColor>(1.0, 0.15, 0.15)</defaultLabelColor>
    <stages>
      <li>
        <label>sentinel</label>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <label>acute</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>terminal</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.35</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.15</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Bloodtype_PostCrisisInjury</defName>
    <label>post-transfusion organ injury</label>
    <description>A severe post-crisis inflammatory and filtration injury after transfusion shock. Recovery is slow and requires prolonged rest.</description>
    <hediffClass>BloodtypeHardcore.Hediff_PostCrisisInjury</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <defaultLabelColor>(1.0, 0.65, 0.25)</defaultLabelColor>
    <stages>
      <li>
        <label>critical recovery</label>
        <painOffset>0.20</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.65</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.12</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.50</minSeverity>
        <label>recovering</label>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.82</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.06</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Bloodtype_ClinicalComa</defName>
    <label>clinical coma</label>
    <description>A profound medically induced coma triggered while stabilizing a catastrophic transfusion reaction. The patient is fully incapacitated and requires intensive monitoring.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <defaultLabelColor>(0.7, 0.9, 1.0)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.01</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
