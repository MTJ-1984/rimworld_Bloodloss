<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef ParentName="SurgeryFlesh">
    <defName>StabilizeTransfusionCrisis</defName>
    <label>stabilize transfusion crisis</label>
    <description>Attempt emergency stabilization of a catastrophic transfusion crisis. Uses surgery-quality factors and medicine quality to determine rescue chance.</description>
    <workerClass>BloodtypeHardcore.Recipe_StabilizeTransfusionCrisis</workerClass>
    <jobString>Performing emergency transfusion stabilization on TargetA.</jobString>
    <workAmount>450</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <deathOnFailedSurgeryChance>0</deathOnFailedSurgeryChance>
    <surgerySuccessChanceFactor>1</surgerySuccessChanceFactor>
    <dontShowIfAnyIngredientMissing>false</dontShowIfAnyIngredientMissing>
    <removesHediff>Bloodtype_TransfusionCrisis</removesHediff>
    <descriptionHyperlinks>
      <ThingDef>MedicineUltratech</ThingDef>
      <HediffDef>Bloodtype_TransfusionCrisis</HediffDef>
      <HediffDef>Bloodtype_PostCrisisInjury</HediffDef>
    </descriptionHyperlinks>
    <uiIconThing>MedicineUltratech</uiIconThing>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Medicine</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>Medicine</li>
      </categories>
    </fixedIngredientFilter>
  </RecipeDef>

</Defs>
